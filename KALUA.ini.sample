; KALUA configuration file.
;
; Copy this file to ./KALUA.INI (the default location, next to where you run
; KALUA) and edit to taste. An alternate path can be given with --ini <path>
; on any command, or the KALUA_INI environment variable.
;
; Precedence: CLI flags > KALUA.INI > environment variables > built-in defaults.
; Section and key names are case-insensitive and '-'/'_' are interchangeable
; (no-browser == no_browser == NO_BROWSER). Boolean values accept
; 1/true/yes/on and 0/false/no/off; a bare key without '=' means "true".
; Unknown keys are ignored, and repeated keys append (used by db/arg/allow-fs).

[RUN]
no-browser    = 1            ; don't auto-open the browser
port          = 9000
watch         = 1            ; hot-reload open tabs when the app script changes
session-limit = 8
verbose       = 1            ; maps to the -v flag
; test        = 0            ; headless test mode (no HTTP server)
; repl-on-error = 0
; db          = main=sqlite://app.db   ; repeat the key for more connections
; arg         = env=dev
; allow-fs    = ./data

[SERVE]
host    = 127.0.0.1
port    = 8080
workers = 8
mode    = http,ws           ; http, ws, tcp, or a comma-separated combination
verbose = 1
; db    = main=sqlite://app.db
; arg   = env=prod

[BUILDER]
port       = 9001
no-browser = 0
; model     = local-model   ; optional AI model override
; base-url  = http://localhost:1234/v1
; db        = main=sqlite://app.db   ; live data previews for table/looper editors

[CHECK]
verbose = 1
; Formatting flags (gofmt-style): as soon as one is set, check formats instead
; of validating. -w wins over -d over -l over --format.
; format = 1            ; print formatted source to stdout (exit 0 even if dirty)
; w      = 1            ; write formatted source back in place (permissions kept)
; l      = 1            ; list files whose formatting differs (exit 1 if any)
; d      = 1            ; print a 0-context unified diff (exit 1 if any)

[TEST]
verbose = 1
; HTTP/WS/TCP probe flags for serve-mode apps (the mode is auto-detected).
; http = GET /api/status
; http = POST /api/run
; expect-status     = 200
; expect-body-json  = {"ok":true}
; expect-contains   = hello
; ws-echo           = ping
; tcp-echo          = ping
; db                = main=sqlite://app.db
; arg               = env=test
; allow-fs          = ./data

[AI]
; LLM connection settings for KALUA ai and the builder's AI panel.
; These keys mirror the KALUA_AI_* env vars and override them; explicit
; command-line flags (--model, --base-url, --api-key-env) win over everything.
; When the base URL points at OpenRouter and no API key is set, the
; OPENAI_API_KEY environment variable is used as a fallback.
KALUA_AI_BASE_URL = https://openrouter.ai/api/v1
KALUA_AI_API_KEY  = sk-or-v1-0000000000000000000000000000000000
KALUA_AI_MODEL    = nvidia/nemotron-3.5-lightning:free