{
  "name": "Lua",
  "scopeName": "source.lua",
  "fileTypes": ["lua"],
  "patterns": [
    {
      "name": "comment.line.shebang.lua",
      "match": "^#!.*$"
    },
    {
      "name": "comment.block.lua",
      "begin": "--\\[\\[",
      "end": "\\]\\]",
      "captures": {
        "0": { "name": "punctuation.definition.comment.lua" }
      }
    },
    {
      "name": "comment.line.double-dash.lua",
      "match": "--.*$"
    },
    {
      "name": "string.quoted.single.lua",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.lua" }
      },
      "end": "'",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.lua" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.lua",
          "match": "\\\\(\\\\|'|\"|a|b|f|n|r|t|v|z|0|[0-7]{1,3}|x[0-9a-fA-F]+|u\\{[0-9a-fA-F]+\\})"
        }
      ]
    },
    {
      "name": "string.quoted.double.lua",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.lua" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.lua" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.lua",
          "match": "\\\\(\\\\|'|\"|a|b|f|n|r|t|v|z|0|[0-7]{1,3}|x[0-9a-fA-F]+|u\\{[0-9a-fA-F]+\\})"
        }
      ]
    },
    {
      "name": "string.quoted.longbracket.lua",
      "begin": "\\[=*\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.lua" }
      },
      "end": "\\]=*\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.lua" }
      }
    },
    {
      "name": "constant.numeric.lua",
      "match": "\\b(0[xX][0-9a-fA-F]+|\\d+(\\.\\d+)?([eE][+-]?\\d+)?|0[bB][01]+)\\b"
    },
    {
      "name": "keyword.control.lua",
      "match": "\\b(and|break|do|else|elseif|end|for|function|goto|if|in|local|not|or|repeat|return|then|until|while)\\b"
    },
    {
      "name": "constant.language.lua",
      "match": "\\b(true|false|nil)\\b"
    },
    {
      "name": "support.function.lua",
      "match": "\\b(assert|collectgarbage|dofile|error|getmetatable|ipairs|load|loadfile|next|pairs|pcall|print|rawequal|rawget|rawlen|rawset|require|select|setmetatable|tonumber|tostring|type|unpack|xpcall|warn)\\b"
    },
    {
      "name": "support.table.lua",
      "match": "\\b(function|pairs2|table|string|math|io|os|debug|coroutine|package|utf8|bit|bit32|str|ari|win|app|socket)\\b(?=\\.)"
    },
    {
      "name": "keyword.operator.lua",
      "match": "(:=|==|~=|<=|>=|<>|<|>|\\+|-|\\*|/|%|#|\\^|::|\\.\\.\\.|\\.\\.|=)"
    },
    {
      "name": "punctuation.definition.lua",
      "match": "[\\[\\]\\(\\)\\{\\}.,;:]"
    },
    {
      "name": "variable.other.lua",
      "match": "[A-Za-z_][A-Za-z0-9_]*"
    }
  ]
}