{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "lua": {
      "command": ["./KALUA", "lsp"],
      "extensions": [".lua"]
    }
  },
  "mcp": {
    "kalua": {
      "type": "local",
      "command": ["./KALUA", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "commands": [
        "./KALUA check *",
        "./KALUA run *",
        "./KALUA serve *",
        "./KALUA new *",
        "./KALUA lsp",
        "./KALUA mcp",
        "./KALUA version",
        "go build -o KALUA ./cmd/KALUA *",
        "go test ./..."
      ]
    }
  }
}
