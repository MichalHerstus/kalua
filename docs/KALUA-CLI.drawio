<mxfile host="app.diagrams.net">
  <diagram name="Stránka-1" id="ftzlJ11BjKekn4BHcWYe">
    <mxGraphModel dx="964" dy="633" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart LR\n    %% ============================================================\n    %% KALUA CLI — A4 Landscape Compact Layout\n    %% Source: USER_GUIDE.md §3\n    %% ============================================================\n    \n    classDef cmdNode fill:#e8f4f8,stroke:#6c8ebf,stroke-width:2px,rounded=1,html=1,fontSize=11\n    classDef flagNode fill:#fff9e6,stroke:#d6b656,stroke-width:1px,rounded=1,html=1,fontSize=10\n    classDef flagDetail fill:#f5f5f5,stroke:#999,stroke-width:1px,dashed=1,html=1,fontSize=9\n    classDef sectionNode fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,rounded=1,html=1,fontSize=12\n    classDef restrictionNode fill:#fce4ec,stroke:#c62828,stroke-width:1px,rounded=1,html=1,fontSize=9\n    classDef exitNode fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,rounded=1,html=1,fontSize=10\n    classDef iniNode fill:#fff2cc,stroke:#d6b656,stroke-width:2px,rounded=1,html=1,fontSize=10\n    classDef aiNode fill:#e0f2f1,stroke:#00695c,stroke-width:2px,rounded=1,html=1,fontSize=10\n\n    %% Title\n    title[[\&quot;&lt;b&gt;KALUA CLI Reference&lt;/b&gt;&lt;br/&gt;&lt;i&gt;USER_GUIDE.md §3 | A4 Landscape&lt;/i&gt;\&quot;]]\n    title:::sectionNode\n\n    %% Column 1: Commands\n    subgraph Col1 [\&quot;Commands\&quot;]\n        direction TB\n        cRun[[\&quot;&lt;b&gt;run&lt;/b&gt; app.lua&lt;br/&gt;Interactive web app&lt;br/&gt;127.0.0.1:9000&lt;br/&gt;Per-tab Lua session\&quot;]]\n        cRun:::cmdNode\n        \n        cServe[[\&quot;&lt;b&gt;serve&lt;/b&gt; app.lua&lt;br/&gt;Headless API&lt;br/&gt;HTTP/WS/TCP&lt;br/&gt;Worker pool + k.shared.*\&quot;]]\n        cServe:::cmdNode\n        \n        cCheck[[\&quot;&lt;b&gt;check&lt;/b&gt; app.lua&lt;br/&gt;Static validation&lt;br/&gt;Syntax, unknown k.*, main()&lt;br/&gt;+ gofmt-style formatter\&quot;]]\n        cCheck:::cmdNode\n        \n        cBuilder[[\&quot;&lt;b&gt;builder&lt;/b&gt; app.lua&lt;br/&gt;Visual form editor&lt;br/&gt;Multi-form .lua/.json&lt;br/&gt;AI chat panel\&quot;]]\n        cBuilder:::cmdNode\n        \n        cAI[[\&quot;&lt;b&gt;ai&lt;/b&gt; gen|fix|val&lt;br/&gt;NL → Lua&lt;br/&gt;generate/fix/validate\&quot;]]\n        cAI:::aiNode\n        \n        cNew[[\&quot;&lt;b&gt;new&lt;/b&gt; name&lt;br/&gt;Scaffold app.lua\&quot;]]\n        cNew:::cmdNode\n        \n        cLSP[[\&quot;&lt;b&gt;lsp&lt;/b&gt;&lt;br/&gt;Language Server&lt;br/&gt;(stdio, UTF-8)\&quot;]]\n        cLSP:::cmdNode\n        \n        cMCP[[\&quot;&lt;b&gt;mcp&lt;/b&gt;&lt;br/&gt;MCP Server&lt;br/&gt;(stdio, 9 tools)\&quot;]]\n        cMCP:::cmdNode\n        \n        cVer[[\&quot;&lt;b&gt;version&lt;/b&gt;&lt;br/&gt;Print version\&quot;]]\n        cVer:::cmdNode\n    end\n\n    %% Column 2: run flags\n    subgraph Col2 [\&quot;run flags\&quot;]\n        direction TB\n        rPort[[\&quot;-p, --port N (9000, 0=ephemeral)\&quot;]]\n        rPort:::flagNode\n        rNB[[\&quot;-n, --no-browser\&quot;]]\n        rNB:::flagNode\n        rSL[[\&quot;-l, --session-limit N (8)\&quot;]]\n        rSL:::flagNode\n        rTest[[\&quot;--test (headless, no HTTP)\&quot;]]\n        rTest:::flagNode\n        rWatch[[\&quot;--watch (poll 400ms, hot reload)\&quot;]]\n        rWatch:::flagNode\n        rVerb[[\&quot;-v, --verbose (trace k.* calls)\&quot;]]\n        rVerb:::flagNode\n        rRepl[[\&quot;--repl-on-error (REPL at crash)\&quot;]]\n        rRepl:::flagNode\n        rDbg[[\&quot;--debug (stub, not impl)\&quot;]]\n        rDbg:::flagNode\n        rDB[[\&quot;-d, --db NAME=DSN (repeatable)\&quot;]]\n        rDB:::flagNode\n        rArg[[\&quot;-a, --arg K=V (→ ARGS table)\&quot;]]\n        rArg:::flagNode\n        rFS[[\&quot;-f, --allow-fs PATH (repeatable)\&quot;]]\n        rFS:::flagNode\n        rIni[[\&quot;--ini PATH\&quot;]]\n        rIni:::flagNode\n    end\n\n    %% Column 3: serve flags\n    subgraph Col3 [\&quot;serve flags\&quot;]\n        direction TB\n        sHost[[\&quot;--host H (127.0.0.1)\&quot;]]\n        sHost:::flagNode\n        sPort[[\&quot;-p, --port N (8080)\&quot;]]\n        sPort:::flagNode\n        sWork[[\&quot;-w, --workers N (4)\&quot;]]\n        sWork:::flagNode\n        sMode[[\&quot;-m, --mode http|ws|tcp (csv)\&quot;]]\n        sMode:::flagNode\n        sVerb[[\&quot;-v, --verbose\&quot;]]\n        sVerb:::flagNode\n        sDbg[[\&quot;--debug/--debug-worker (stub)\&quot;]]\n        sDbg:::flagNode\n        sDB[[\&quot;-d/--db, -a/--arg, -f/--allow-fs\&quot;]]\n        sDB:::flagNode\n        sIni[[\&quot;--ini PATH\&quot;]]\n        sIni:::flagNode\n        sSig[[\&quot;Signals:&lt;br/&gt;SIGTERM/INT → shutdown()&lt;br/&gt;SIGHUP → hot reload&lt;br/&gt;(atomic worker swap)\&quot;]]\n        sSig:::restrictionNode\n    end\n\n    %% Column 4: check/formatter\n    subgraph Col4 [\&quot;check / formatter\&quot;]\n        direction TB\n        chkVal[[\&quot;Validation (default):&lt;br/&gt;syntax, unknown k.*, missing main\&quot;]]\n        chkVal:::flagDetail\n        chkFmt[[\&quot;--format → stdout (no write)\&quot;]]\n        chkFmt:::flagNode\n        chkW[[\&quot;-w → write in place (perm)\&quot;]]\n        chkW:::flagNode\n        chkL[[\&quot;-l files... → list unformatted\&quot;]]\n        chkL:::flagNode\n        chkD[[\&quot;-d → unified diff\&quot;]]\n        chkD:::flagNode\n        chkPri[[\&quot;Priority: -w &gt; -d &gt; -l &gt; --format&lt;br/&gt;Single file: flag anywhere&lt;br/&gt;Multi-file: flag first\&quot;]]\n        chkPri:::restrictionNode\n        chkRules[[\&quot;Rules: 2-space indent, normalize spacing,&lt;br/&gt;preserve comments/strings, idempotent,&lt;br/&gt;re-parses output\&quot;]]\n        chkRules:::flagDetail\n        chkIni[[\&quot;[CHECK] in KALUA.INI:&lt;br/&gt;format, w, l, d, verbose\&quot;]]\n        chkIni:::iniNode\n    end\n\n    %% Column 5: builder + ai + ini\n    subgraph Col5 [\&quot;builder • ai • INI\&quot;]\n        direction TB\n        bNB[[\&quot;-n, --no-browser\&quot;]]\n        bNB:::flagNode\n        bPort[[\&quot;-p, --port N (9001)\&quot;]]\n        bPort:::flagNode\n        bModel[[\&quot;--model NAME\&quot;]]\n        bModel:::flagNode\n        bIni[[\&quot;--ini PATH\&quot;]]\n        bIni:::iniNode\n        bFeat[[\&quot;Features: multi-form v3, source-preserving,&lt;br/&gt;AST import (line spans), verbatim handlers,&lt;br/&gt;v2→v3 migration, AI chat (/api/ai/stream),&lt;br/&gt;Tabulator proxy, tabbed modal\&quot;]]\n        bFeat:::flagDetail\n        \n        aiGen[[\&quot;generate \\\&quot;req\\\&quot; [-o file]\&quot;]]\n        aiGen:::aiNode\n        aiFix[[\&quot;fix app.lua\&quot;]]\n        aiFix:::aiNode\n        aiVal[[\&quot;validate app.lua\&quot;]]\n        aiVal:::aiNode\n        aiCfg[[\&quot;Config precedence:&lt;br/&gt;1. CLI flags&lt;br/&gt;2. [AI] in INI&lt;br/&gt;3. KALUA_AI_* env&lt;br/&gt;4. OPENAI_API_KEY (OpenRouter)\&quot;]]\n        aiCfg:::restrictionNode\n        \n        iniSearch[[\&quot;INI Search (1st wins):&lt;br/&gt;1. --ini path&lt;br/&gt;2. KALUA_INI env&lt;br/&gt;3. ./KALUA.INI&lt;br/&gt;Missing default=OK, explicit missing=exit 3\&quot;]]\n        iniSearch:::iniNode\n        iniPrec[[\&quot;Precedence: CLI &gt; INI &gt; env &gt; defaults&lt;br/&gt;INI only fills unset CLI flags\&quot;]]\n        iniPrec:::restrictionNode\n        iniFmt[[\&quot;Format: [SECTION] key=value&lt;br/&gt;Sections: RUN, SERVE, BUILDER, CHECK, AI&lt;br/&gt;Keys=long flags (case-ins, -/_=)&lt;br/&gt;Bool: 1/true/yes/on | 0/false/no/off&lt;br/&gt;Bare key=true, repeat→append\&quot;]]\n        iniFmt:::flagDetail\n        iniEx[[\&quot;Example: KALUA.ini.sample&lt;br/&gt;[RUN] no-browser=1 port=9000 watch=1&lt;br/&gt;[AI] KALUA_AI_BASE_URL=...&lt;br/&gt;KALUA_AI_API_KEY=...&lt;br/&gt;KALUA_AI_MODEL=...\&quot;]]\n        iniEx:::iniNode\n    end\n\n    %% Column 6: Exit codes + Restrictions\n    subgraph Col6 [\&quot;Exit Codes • Restrictions\&quot;]\n        direction TB\n        ex0[[\&quot;0 — OK\&quot;]]\n        ex0:::exitNode\n        ex1[[\&quot;1 — Script/Runtime Error\&quot;]]\n        ex1:::exitNode\n        ex2[[\&quot;2 — CLI Usage Error\&quot;]]\n        ex2:::exitNode\n        ex3[[\&quot;3 — File I/O Error\&quot;]]\n        ex3:::exitNode\n        \n        rSand[[\&quot;Sandbox: no require, print, dofile,&lt;br/&gt;loadfile, os.execute, io, os.getenv&lt;br/&gt;Use k.* API (k.print, k.file_*)\&quot;]]\n        rSand:::restrictionNode\n        rModes[[\&quot;run: UI bindings only (forms, controls)&lt;br/&gt;serve: handle_http/ws/tcp + k.shared.*&lt;br/&gt;UI in serve → runtime error\&quot;]]\n        rModes:::restrictionNode\n        rMain[[\&quot;Must define function main()&lt;br/&gt;(entry point for both modes)\&quot;]]\n        rMain:::restrictionNode\n        rFlags[[\&quot;Flags before OR after script arg&lt;br/&gt;--ini works for all commands&lt;br/&gt;ARGS from --arg K=V\&quot;]]\n        rFlags:::flagDetail\n        rDSN[[\&quot;DSN: sqlite:// mysql://&lt;br/&gt;postgres:// sqlserver://&lt;br/&gt;--db NAME=DSN → k.connect_db(\\\&quot;#NAME\\\&quot;)\&quot;]]\n        rDSN:::flagDetail\n        rReload[[\&quot;Hot reload: run --watch / SIGHUP&lt;br/&gt;400ms poll + SHA256 dedupe&lt;br/&gt;Broken script → keeps old app\&quot;]]\n        rReload:::restrictionNode\n    end\n\n    %% Connections (invisible, just for layout)\n    title --&gt; Col1\n    Col1 --&gt; Col2\n    Col2 --&gt; Col3\n    Col3 --&gt; Col4\n    Col4 --&gt; Col5\n    Col5 --&gt; Col6&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="76">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
